ry"/></mxCell><mxCell id="e1" value="&lt;span style=&#x27;background-color:#ffffff&#x27;&gt;invoke async&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;fontSize=11;fontFamily=Arial;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="eu" source="sch" target="fn"><mxGeometry relative="1" x="-0.36" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;span style=&#x27;background-color:#ffffff&#x27;&gt;snapshot prices/ keys&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;fontSize=11;fontFamily=Arial;exitX=0;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="eu" source="bronze" target="fn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="569" y="129"/><mxPoint x="569" y="200"/></Array></mxGeometry></mxCell><mxCell id="e3" value="&lt;span style=&#x27;background-color:#ffffff&#x27;&gt;publish build + quality report&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;fontSize=11;fontFamily=Arial;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="eu" source="fn" target="silver"><mxGeometry relative="1" x="-0.08" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="&lt;span style=&#x27;background-color:#ffffff&#x27;&gt;failure / quality warning&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;fontSize=11;fontFamily=Arial;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="eu" source="fn" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="&lt;span style=&#x27;background-color:#ffffff&#x27;&gt;logs&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;fontSize=11;fontFamily=Arial;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="eu" source="fn" target="logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="DuckDB transform + blocking quality gate" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;" vertex="1" parent="eu"><mxGeometry x="350" y="310" width="280" height="45" as="geometry"/></mxCell><mxCell id="n2" value="Same scraper bucket; different prefixes." style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;" vertex="1" parent="eu"><mxGeometry x="830" y="180" width="260" height="30" as="geometry"/></mxCell><mxCell id="n3" value="SNS -&amp;gt; Pushover forwarder" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;" vertex="1" parent="eu"><mxGeometry x="350" y="610" width="260" height="30" as="geometry"/></mxCell><mxCell id="n4" value="No VPC; no new alarm or metric." style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;" vertex="1" parent="eu"><mxGeometry x="830" y="640" width="300" height="30" as="geometry"/></mxCell><mxCell id="co1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="eu"><mxGeometry x="10" y="150" width="24" height="24" as="geometry"/></mxCell><mxCell id="co2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="eu"><mxGeometry x="630" y="40" width="24" height="24" as="geometry"/></mxCell><mxCell id="co3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="eu"><mxGeometry x="310" y="280" width="24" height="24" as="geometry"/></mxCell><mxCell id="co4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="eu"><mxGeometry x="630" y="270" width="24" height="24" as="geometry"/></mxCell><mxCell id="co5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="eu"><mxGeometry x="310" y="450" width="24" height="24" as="geometry"/></mxCell><mxCell id="steps" value="1. Scheduler invokes the build; the handler snapshots the bronze key list.&lt;br&gt;2. DuckDB transform and the blocking quality gate run on the local build.&lt;br&gt;3. The quality report is computed before publish; a query error fails the build.&lt;br&gt;4. A verified build and pointer are published under silver/builds/.&lt;br&gt;5. The report and _latest.json are written; a breach sends one warning." style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;" vertex="1" parent="eu"><mxGeometry x="830" y="500" width="540" height="98" as="geometry"/></mxCell><mxCell id="lg_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="300" height="78" as="geometry"/></mxCell><mxCell id="lg_title" value="Legend" style="text;html=1;fontSize=11;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="108" y="764" width="80" height="20" as="geometry"/></mxCell><mxCell id="lg_l0" value="" style="endArrow=open;endFill=0;endSize=8;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="798" as="sourcePoint"/><mxPoint x="150" y="798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_