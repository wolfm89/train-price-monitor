{
  "name": "tpm-backend",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "codegen": "graphql-codegen --config src/codegen.yml",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "build": "npm run codegen && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --test scripts/backfill-cognito-sub-lib.test.mjs scripts/backfill-ttl-lib.test.mjs scripts/cleanup-ses-identities-lib.test.mjs && ts-node --transpile-only src/lib/journeyMatcher.test.ts && ts-node --transpile-only src/lib/privacy.test.ts && ts-node --transpile-only src/managers/SESManager.test.ts",
    "stations": "node scripts/build-station-index.mjs",
    "schema": "node scripts/build-schema.mjs",
    "generate": "npm run stations && npm run schema",
    "backfill:cognito-sub": "node scripts/backfill-cognito-sub.mjs",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run generate",
    "predev": "npm run generate",
    "prestart": "npm run generate",
    "dev:types": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.0",
    "@types/aws-lambda": "^8.10.115",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/hafas-client": "^6.3.1",
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "db-hafas-stations": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.1.0",
    "prettier": "^3.0.0",
    "ts-node": "10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.32.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1045.0",
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-sesv2": "^3.1045.0",
    "@aws-sdk/client-sqs": "^3.1045.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@graphql-tools/schema": "^10.1.5",
    "@graphql-yoga/plugin-response-cache": "^3.26.6",
    "body-parser": "^1.20.9",
    "cors": "^2.8.5",
    "cross-fetch": "^4.0.0",
    "db-vendo-client": "^6.11.2",
    "dotenv": "^16.4.5",
    "dynamodb-toolbox": "^2.0.0",
    "express": "^4.22.3",
    "graphql": "^16.8.1",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^5.24.6",
    "uuid": "^14.0.0"
  }
}
