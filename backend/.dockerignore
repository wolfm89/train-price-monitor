# The image only needs the pre-built bundle (dist/main.js) and
# the SDL copied by the Dockerfile. Excluding the rest keeps the build context —
# and therefore the CDK asset tarball that is uploaded to S3 on deploy — free of
# local files.
node_modules

# Never ship local environment files: backend/.env is written by
# `mise run env:local` and holds real values.
.env
.env.*
