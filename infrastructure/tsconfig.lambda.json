{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": {
      "@aws-sdk/client-lambda": ["./node_modules/@aws-sdk/client-lambda/dist-types/index.d.ts"],
      "@aws-sdk/client-ssm": ["./node_modules/@aws-sdk/client-ssm/dist-types/index.d.ts"]
