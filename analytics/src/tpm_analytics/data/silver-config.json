{
  "prefix": "silver",
  "bronze_prefix": "prices",
  "builds_root": "builds",
  "manifest_name": "_manifest.json",
  "pointer_name": "_latest.json",
  "failure_event": "silver_build_failed",
  "stages": ["settings", "preflight", "snapshot", "build", "report", "publish"],
  "keep": 2,
  "lambda": {
    "memory_mib": 10240,
    "timeout_seconds": 900,
    "ephemeral_mib": 10240,
    "threads": 2,
    "duckdb_memory_limit": "6GB",
    "duckdb_max_temp_size": "7GB",
    "publish_reserve_seconds": 180,
    "build_budget_seconds": 690,
    "retry_attempts": 1,
    "max_event_age_minutes": 45
  },
  "local": {
    "threads": 2,
    "duckdb_memory_limit": "700MB",
    "duckdb_max_temp_size": "4GB"
  },
  "schedule": {
    "retry_attempts": 2,
    "max_event_age_minutes": 5
  },
  "orphan_grace_seconds": 3600,
  "min_build_age_seconds": 86400,
  "quality": {
    "report_version": 1,
    "prefix": "quality",
    "pointer_name": "_latest.json",
    "event": "silver_quality_failed",
    "expected_route_count": 140,
    "window_days": 7,
    "baseline_days": 28,
    "final_7d_coverage_min": 0.8,
    "final_24h_coverage_min": 0.6,
    "route_coverage_min": 0.9,
    "rows_drop_pct_max": 0.35,
    "freshness_hours_max": 36,
    "fare_null_rate_max": 0.1,
    "load_factor_null_rate_max": 0.35
  }
}
